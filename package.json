    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.272.0",
    "aws-cdk-local": "^3.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.2.0",
